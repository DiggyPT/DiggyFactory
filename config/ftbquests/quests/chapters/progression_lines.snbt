	quests: [
		{
			description: ["This is the &lProcessing Lines&r tab. Here you can view how you can string industrial processes together to get finished products. Very useful if you want to passively automate things."]
			icon: "thermal:signalum_gear"
			id: "57996C8D751C9598"
			shape: "gear"
			size: 2.0d
			subtitle: "How does this work?"
			tasks: [{
				id: "6FA41E6BA9E7FE87"
				title: "Cool"
				type: "checkmark"
			}]
			title: "Info"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["57996C8D751C9598"]
			description: [
				"While you can make rubber the GregTech way, you will probably want to automate it the Thermal way. You can do this by obtaining the &lArboreal Extractor&r which is unlocked in the Steam Age. For it to work you need to place it next to a tree so that its back is facing the trunk, and then it starts working! The only problem is that it's pretty slow."
				"Also, if lots of extractors are taking from the same tree, they will lose efficiency, so for maximum efficiency put each extractor on a separate tree."
				""
				"&9Note:&r Different trees output different fluids! Check EMI for the list! "
			]
			icon: "thermal:device_tree_extractor"
			id: "25B2134258088C7F"
			rewards: [{
				id: "439172B05F25049E"
				item: {
					Count: 1
					id: "naturescompass:naturescompass"
					tag: { }
				}
				type: "item"
			}]
			subtitle: "Taking out fluids from Trees"
			tasks: [
				{
					id: "3080DFAB73C7D9C6"
					item: "thermal:device_tree_extractor"
					type: "item"
				}
				{
					id: "17366CB4086C429F"
					title: "Automated"
					type: "checkmark"
				}
			]
			title: "Arboreal Extraction"
			x: 3.0d
			y: 2.5d
		}
		{
			dependencies: ["25B2134258088C7F"]
			description: [
				"Latex is made from hooking up an arboreal extractor to a jungle or rubberwood (NOT just rubber!) tree."
				""
				"If you want to make a Thermal rubberwood sapling, put a GregTech rubber sapling in a crafting table."
			]
			icon: "thermal:latex_bucket"
